{
  "name": "webber",
  "productName": "Webber",
  "version": "0.1.0",
  "description": "A clean Chromium-based browser that uses your Omarchy theme and can be used by Claude.",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "app.webber.browser",
    "productName": "Webber",
    "files": [
      "src/**/*",
      "bin/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;WebBrowser",
      "executableName": "webber",
      "icon": "build/icon.png",
      "artifactName": "Webber-${version}-${arch}.AppImage",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/xhtml+xml"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "Webber",
          "Keywords": "browser;web;internet;"
        }
      },
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "asarUnpack": [
      "bin/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "webber-mcp": "bin/webber-mcp.js"
  },
  "author": "Webber",
  "homepage": "https://github.com/gosanikanov-spec/electron-browser",
  "desktopName": "webber.desktop"
}
